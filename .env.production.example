# =============================================================================
# BY THE HANDFUL — PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# SECURITY PROTOCOL:
# 1. NEVER commit production credentials to source control.
# 2. Inject these values via your production hosting environment dashboard
#    (e.g., Vercel, Netlify, Railway, or Docker secrets).
# 3. Switch VITE_RAZORPAY_KEY_ID to rzp_live_ ONLY as a final, isolated deploy step!

# Production Supabase Project (Isolated production customer data & orders)
SUPABASE_URL="https://your-prod-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_prod_supabase_publishable_key"
VITE_SUPABASE_URL="https://your-prod-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_prod_supabase_publishable_key"
VITE_SUPABASE_PROJECT_ID="your_prod_project_id"

# Production Service Role Key (Keep strictly confidential!)
SUPABASE_SERVICE_ROLE_KEY="your_prod_service_role_key"

# Razorpay LIVE Mode Credentials (SWITCH ONLY AS FINAL SEPARATE STEP IN PROD DASHBOARD)
VITE_RAZORPAY_KEY_ID="rzp_live_your_live_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_live_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_live_webhook_secret"

# AI Configuration (Optional)
GEMINI_API_KEY="your_prod_gemini_api_key"
